{
  "manifest_version": 2,
  "name": "[build:20260925-054903-fe14] Multi-site iframe bypass (localhost dev)",
  "version": "2.0.1",
  "description": "Strips framing headers and imbues real first-party cookies so Slack, WhatsApp Web, and muse.ai can be iframed from http://localhost:8765. Bridges DOM read/write + chat text both ways. Dev/throwaway.",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "cookies",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.slack.com/*",
        "*://slack.com/*",
        "*://*.whatsapp.com/*",
        "*://web.whatsapp.com/*",
        "*://muse.ai/*",
        "*://*.muse.ai/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "browser_action": {
    "default_title": "[build:20260925-054903-fe14] Multi-site iframe bypass (active on localhost:8765)"
  }
}
