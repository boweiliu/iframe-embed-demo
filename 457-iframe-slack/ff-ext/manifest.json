{
  "manifest_version": 2,
  "name": "Slack iframe bypass (localhost dev)",
  "version": "1.3.0",
  "description": "Strips framing headers, imbues real slack.com cookies, and bridges DOM read/write between localhost:8765 and the *.slack.com iframe via postMessage. Dev/throwaway.",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "cookies",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.slack.com/*", "*://slack.com/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "Slack iframe bypass (active on localhost:8765)"
  }
}
